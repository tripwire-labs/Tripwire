# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# x402 / Circle Nanopayments
# Run `npm run generate-wallets` to auto-generate both seller and buyer wallets
SELLER_ADDRESS=0xYourWalletAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey

# Buyer wallet (for the payment agent)
BUYER_ADDRESS=0xYourBuyerWalletAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey

# LangChain deep agent (OpenAI) — optional
# If omitted, the agent runs in mock mode with scripted tool calls.
OPENAI_API_KEY=your-openai-api-key

# ERC-8004 agent IDs (see contracts/ for the Identity Registry these are registered on)
BUYER_AGENT_ID=your-buyer-agent-id
SELLER_AGENT_ID=your-seller-agent-id

# Tripwire escrow contracts — deployed and verified on Arc testnet 2026-08-07, see
# plans/06-build-sequence.md for the full record. Shared, permanent infrastructure —
# point at these same contracts rather than redeploying your own.
JOB_ESCROW_ADDRESS=0xf8222D7d7c31AAE7745A20a3F97BddB03D6254D7
SELLER_BOND_ADDRESS=0xed8D1d16150e4a7b146c8A29324537E14bD88988
# Permanent owner of both contracts and JobEscrow's immutable ARBITER — a dedicated
# wallet, deliberately not the buyer or seller wallet. Documented here for reference;
# no code currently reads this env var.
ARBITER_ADDRESS=0xC2Ce96f61a40B54C74f30f1Da73E3b8dcf3e2A2c

# Shared secret protecting /api/gateway/withdraw (moves real funds — was previously
# unauthenticated). NEXT_PUBLIC_ so the dashboard can send it; not real per-user auth,
# just closes automated/opportunistic access to this single-operator app. Both must
# match — set the same value for both.
WITHDRAW_API_KEY=
NEXT_PUBLIC_WITHDRAW_API_KEY=
